msgstr ""

msgctxt "#30351"
msgid "Resume Downloads After Streaming Stops"
msgstr ""

msgctxt "#30352"
msgid "How long downloads keep waiting after you stop streaming, in case you're only picking something else to play. Starting a video or music from your Kodi library ends the wait at once. Pausing a song, and the moments between songs in a playlist, never count as stopping."
msgstr ""

