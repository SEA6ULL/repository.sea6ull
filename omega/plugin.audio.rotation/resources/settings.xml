<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Kodi 19+ settings format.

  The required hierarchy is:
      settings > section > category > group > setting

  Skipping the <category> level, or omitting the <control> element on a
  setting, makes Kodi fail to parse this file silently - the addon's
  Configure button simply never appears. The format version is 1.
-->
<settings version="1">
    <section id="plugin.audio.rotation">

        <category id="general" label="30000">
            <group id="2" label="30020">
                <setting id="page_size" type="integer" label="30021">
                    <level>0</level>
                    <default>40</default>
                    <constraints>
                        <minimum>10</minimum>
                        <step>10</step>
                        <maximum>100</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="show_not_in_library" type="boolean" label="30022" help="30023">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="show_artist_album_years" type="boolean" label="30068" help="30069">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="use_kodi_library" type="boolean" label="30072" help="30073">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="explicit_content" type="string" label="30026" help="30027">
                    <level>0</level>
                    <default>allow</default>
                    <constraints>
                        <options>
                            <option label="30028">allow</option>
                            <option label="30029">hide</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string"/>
                </setting>
                <setting id="shared_favorites_sync" type="boolean" label="30024" help="30025">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>

        <category id="artwork" label="30001">
            <group id="1" label="30030">
                <setting id="artwork_enabled" type="boolean" label="30031">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="artwork_backgrounds" type="boolean" label="30032">
                    <level>0</level>
                    <default>true</default>
                    <dependencies>
                        <dependency type="enable" setting="artwork_enabled" operator="is">true</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
                <setting id="fanarttv_apikey" type="string" label="30033" help="30074">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="artwork_enabled" operator="is">true</dependency>
                    </dependencies>
                    <control type="edit" format="string">
                        <heading>30033</heading>
                    </control>
                </setting>
                <setting id="artwork_listings" type="boolean" label="30035">
                    <level>0</level>
                    <default>true</default>
                    <dependencies>
                        <dependency type="enable" setting="artwork_enabled" operator="is">true</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
                <setting id="artwork_budget" type="integer" label="30036">
                    <level>0</level>
                    <default>5</default>
                    <constraints>
                        <minimum>2</minimum>
                        <step>1</step>
                        <maximum>15</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="artwork_listings" operator="is">true</dependency>
                    </dependencies>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="artwork_artists" type="boolean" label="30038">
                    <level>0</level>
                    <default>true</default>
                    <dependencies>
                        <dependency type="enable" setting="artwork_enabled" operator="is">true</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
                <setting id="artwork_theaudiodb" type="boolean" label="30039">
                    <level>0</level>
                    <default>true</default>
                    <dependencies>
                        <dependency type="enable" setting="artwork_enabled" operator="is">true</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
                <setting id="theaudiodb_apikey" type="string" label="30043">
                    <level>0</level>
                    <default>123</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="artwork_theaudiodb" operator="is">true</dependency>
                    </dependencies>
                    <control type="edit" format="string"/>
                </setting>
                <setting id="artwork_async" type="boolean" label="30037">
                    <level>0</level>
                    <default>true</default>
                    <dependencies>
                        <dependency type="enable" setting="artwork_enabled" operator="is">true</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
                <setting id="artwork_timeout" type="integer" label="30034">
                    <level>0</level>
                    <default>6</default>
                    <constraints>
                        <minimum>2</minimum>
                        <step>1</step>
                        <maximum>20</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="artwork_enabled" operator="is">true</dependency>
                    </dependencies>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
            </group>
        </category>

        <category id="network" label="30002">
            <group id="1" label="30040">
                <setting id="request_timeout" type="integer" label="30041">
                    <level>0</level>
                    <default>15</default>
                    <constraints>
                        <minimum>5</minimum>
                        <step>5</step>
                        <maximum>60</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="musicmp3_enabled" type="boolean" label="30044" help="30045">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>


        <category id="playlists" label="30050">
            <group id="1" label="30051">
                <setting id="playlist_length" type="integer" label="30052">
                    <level>0</level>
                    <default>100</default>
                    <constraints>
                        <minimum>10</minimum>
                        <step>10</step>
                        <maximum>200</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="playlist_match_threshold" type="integer" label="30053">
                    <level>0</level>
                    <default>86</default>
                    <constraints>
                        <minimum>50</minimum>
                        <step>1</step>
                        <maximum>100</maximum>
                    </constraints>
                    <control type="slider" format="percentage">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="playlist_loose_match" type="boolean" label="30054">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
            </group>

            <group id="2" label="30056">
                <setting id="playlist_prefer_lastfm" type="boolean" label="30057">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="lastfm_apikey" type="string" label="30058">
                    <level>0</level>
                    <default>8a5320c0592121513f1adc243f67ff6d</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30058</heading>
                    </control>
                </setting>
                <setting id="lastfm_username" type="string" label="30070" help="30071">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30070</heading>
                    </control>
                </setting>
                <setting id="lastfm_country" type="string" label="30059">
                    <level>0</level>
                    <default>united states</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30059</heading>
                    </control>
                </setting>
            </group>

            <group id="3" label="30060">
                <setting id="playlist_cache_hours" type="integer" label="30061">
                    <level>0</level>
                    <default>12</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>1</step>
                        <maximum>72</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="library_index_hours" type="integer" label="30062">
                    <level>0</level>
                    <default>24</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>1</step>
                        <maximum>168</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
            </group>
            <group id="4" label="30063">
                <setting id="playlist_unavailable_report" type="boolean" label="30064" help="30065">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="playlist_unavailable_csv" type="boolean" label="30066" help="30067">
                    <level>0</level>
                    <default>true</default>
                    <dependencies>
                        <dependency type="enable" setting="playlist_unavailable_report" operator="is">true</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>

    </section>
</settings>
