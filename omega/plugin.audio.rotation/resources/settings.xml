<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Kodi 19+ settings format.

  The required hierarchy is:
      settings > section > category > group > setting

  Skipping the <category> level, or omitting the <control> element on a
  setting, makes Kodi fail to parse this file silently - the addon's
  Configure button simply never appears. The format version is 1.
-->
