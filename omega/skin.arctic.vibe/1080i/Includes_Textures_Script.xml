<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <!-- SKINMOD: folder renamed ArcticFuse2 -> ArcticVibe with the rest of the rebrand.

         NOTE THIS FILE IS NOT INCLUDED ANYWHERE. Includes.xml pulls in Includes_Textures.xml, which
         includes Includes_Textures_Native.xml, not this one. This is an upstream static copy of the
         script.texturemaker texture set; the version actually used at runtime is GENERATED from
         shortcuts/generator/data/build/textures_script.xmltemplate, with {skindir} substituted.
         Do not wire this file in as-is: its paths lack the "-{skinuser}" / "-defaultuser" suffix that
         the generator appends, so they would not resolve. The single source of truth for the folder
         name is "skindir" in shortcuts/skinvariables-build-colortemplates.json. -->

    <!-- Texture Maker -->
    <include name="Texture_Highlight">
        <texture diffuse="$PARAM[diffuse]">special://profile/addon_data/script.texturemaker/ArcticVibe/main_h.png</texture>
    </include>
    <include name="Texture_Highlight_Focus">
        <texturefocus>special://profile/addon_data/script.texturemaker/ArcticVibe/main_h.png</texturefocus>
        <alttexturefocus>special://profile/addon_data/script.texturemaker/ArcticVibe/main_h.png</alttexturefocus>
    </include>
    <include name="Texture_Highlight_Button_FakeFocus_V">
        <texturefocus border="40">special://profile/addon_data/script.texturemaker/ArcticVibe/menu_v.png</texturefocus>
        <texturenofocus border="40">special://profile/addon_data/script.texturemaker/ArcticVibe/menu_v.png</texturenofocus>
    </include>
    <include name="Texture_Highlight_Button_FakeFocus_H">
        <texturefocus border="40">special://profile/addon_data/script.texturemaker/ArcticVibe/menu_h.png</texturefocus>
        <texturenofocus border="40">special://profile/addon_data/script.texturemaker/ArcticVibe/menu_h.png</texturenofocus>
    </include>
    <include name="Texture_Highlight_ToggleButton_FakeFocus_H">
        <texturenofocus />
        <texturefocus border="40">special://profile/addon_data/script.texturemaker/ArcticVibe/menu_h.png</texturefocus>
        <alttexturefocus border="40">special://profile/addon_data/script.texturemaker/ArcticVibe/menu_h.png</alttexturefocus>
