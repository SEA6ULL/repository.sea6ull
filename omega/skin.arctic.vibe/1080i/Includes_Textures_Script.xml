        <alttexturefocus colordiffuse="$VAR[ColorSettingsToggleButton_Script]" border="40">special://profile/addon_data/script.texturemaker/ArcticVibe/menu_h.png</alttexturefocus>
    </include>
    <include name="Texture_Highlight_Underline_H">
