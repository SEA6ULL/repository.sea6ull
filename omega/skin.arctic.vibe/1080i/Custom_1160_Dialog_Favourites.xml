<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1160">

    <defaultcontrol always="true">450</defaultcontrol>
    <onload>SetProperty(TMDbHelper.ContextMenu,True)</onload>
    <!-- SKINMOD: pick mode (section 38). Shortcuts.PickFavourite holds the url of the shortcut being
         edited while this dialog is open from the shortcut Options menu; it is cleared on every close so
         a normal open of the Favourites dialog always launches. -->
    <onunload>ClearProperty(Shortcuts.PickFavourite,Home)</onunload>
    <controls>

        <include>Dialog_Dim_Overlay</include>

        <control type="group">
            <include>Dimension_DialogWideMenu</include>
            <include>Animation_Right_Delay</include>
            <include content="Dialog_Foreground_Side">
                <param name="dialog_size">Dimension_DialogWideMenu</param>
            </include>

            <!-- Header -->
            <include content="Dialog_Head">
                <param name="label">$LOCALIZE[1036]</param>
            </include>
            <include>Dialog_Head_CloseButton</include>

            <!-- Content -->
            <control type="group">
                <include>Dimension_Dialog_Body</include>
                <include content="List_DialogSelect">
                    <param name="id">450</param>
                    <param name="detailed">True</param>
                    <param name="item_height">100</param>
                    <param name="textcolor">dialog_fg</param>
                    <param name="detailed">True</param>
                    <param name="variation">True</param>
                    <param name="icon">common/_none.png</param>
                    <include>Dimension_Dialog_Body_Group</include>
                    <!-- SKINMOD: launch normally, or in pick mode write the favourite into the shortcut (section 38) -->
                    <onclick condition="String.IsEmpty(Window(Home).Property(Shortcuts.PickFavourite))">RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/builtins/skinvariables-openfavourite.json,use_rules,folderpath=$INFO[Container(450).ListItem.FolderPath])</onclick>
                    <onclick condition="!String.IsEmpty(Window(Home).Property(Shortcuts.PickFavourite))">RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/builtins/skinvariables-setfavouriteshortcut.json,use_rules)</onclick>
                    <content>favourites://</content>
                    <pagecontrol>61</pagecontrol>
                    <onright>61</onright>
                </include>
                <control type="group">
                    <height>40</height>
                    <right>40</right>
                    <bottom>-40</bottom>
                    <include content="Dialog_ItemPage">
                        <param name="id">450</param>
                    </include>
                </control>
                <include content="Dialog_Scrollbar">
                    <param name="id">61</param>
                    <onleft>450</onleft>
                </include>

            </control>

        </control>

    </controls>
</window>
