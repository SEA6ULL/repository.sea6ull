<?xml version="1.0" encoding="UTF-8"?>
<includes>


    <!-- ============== -->
    <!-- OSD Animations -->
    <!-- ============== -->

    <!-- Transitions for Dialogs -->
    <include name="Animation_OSD_Dialog_WindowChange">
        <animation type="WindowOpen" reversible="false">
            <effect type="fade" start="0" end="100" time="200" delay="200" tween="sine" easing="out"/>
        </animation>
        <animation type="WindowClose" reversible="false">
            <effect type="fade" start="100" end="0" time="200" delay="0" tween="sine" easing="out"/>
        </animation>
    </include>
    <include name="Animation_OSD_Dialog_VisibleChange">
        <animation type="Visible" reversible="false">
            <effect type="fade" start="0" end="100" time="200" delay="200" tween="sine" easing="out"/>
        </animation>
        <animation type="Hidden" reversible="false">
            <effect type="fade" start="100" end="0" time="200" delay="0" tween="sine" easing="out"/>
        </animation>
    </include>

    <!-- Slide Expansions for Seekbar -->
    <include name="Animation_OSD_Seekbar_Slide">
        <animation effect="slide" start="0" end="0,80" time="300" tween="sine" easing="inout" condition="$EXP[Exp_OSD_ActiveSlides] + ![Window.IsVisible(videoosd) | Window.IsVisible(musicosd) | $EXP[Exp_OSD_HideControls]]">Conditional</animation>
    </include>
    <include name="Animation_OSD_MusicArtwork_Slide">
        <animation effect="slide" start="0" end="0,160" time="300" tween="sine" easing="inout" condition="![Window.IsVisible(DialogSeekBar.xml)]">Conditional</animation>
        <animation effect="slide" start="0" end="0,80" time="300" tween="sine" easing="inout" condition="![Window.IsVisible(musicosd) | Window.IsVisible(script-cu-lrclyrics-main.xml)]">Conditional</animation>
    </include>

    <!-- SKINMOD: "Match OSD to content" (OSD.MatchToContent).
         Pulls OSD furniture out of the letterbox bars so it is not projected off the top or bottom
         of a constant-image-height (CIH) screen, adjusting automatically to the aspect ratio of
         whatever is playing. Off by default - it is only correct on a zoom-capable projector.

         Offsets are the bar depth in a 1080-line frame: (1080 - 1920/aspect) / 2.
         Kodi normalises VideoPlayer.VideoAspect to a fixed set of ratio strings, so exact
         String.IsEqual matching is safe. Ratios of 1.78 and below are omitted: their bar depth is
         zero (1.78) or the content is pillarboxed (1.66 and narrower), where the image already
         fills the frame height and no vertical adjustment is wanted.

         Every animation here is mutually exclusive on VideoAspect, so at most one applies. Kodi
         stacks conditional animations cumulatively - if two could ever be true at once the offsets
         would ADD. Do not widen these conditions to ranges.

         Direction matters: bottom-anchored furniture must move up (negative) and top-anchored
         furniture must move down (positive). Applying the wrong include pushes a panel further
         into the bar it was supposed to escape.

         NOTHING IN THESE CONDITIONS MAY BE A LIVE PLAYER INFOLABEL.
         VideoPlayer.VideoAspect, Player.HasVideo and Window.IsActive(VideoFullScreen.xml) all go
         false the instant playback stops, while five OSD windows are still fading out. Keying on
         any of them made the OSD snap back to its un-inset position and be drawn there for the
         duration of the fades. The aspect is therefore LATCHED into
         Window(Home).Property(SkinMod.OSDAspect) by an <onload> in VideoFullScreen.xml (playback
         start), VideoOSD.xml and DialogSeekBar.xml (every time the OSD appears). A window property
         survives teardown, so the inset holds until the windows are gone.
         The three write points are belt and braces: at VideoFullScreen onload the stream may not
         have reported its aspect yet, in which case the property lands empty and the first OSD
         open corrects it.
         The property is never cleared. A stale value is harmless because it is only read while an
         OSD window is on screen, and the music guard in Exp_OSD_MatchContent stops a leftover
         video aspect from insetting the shared DialogSeekBar during music playback.

         time="0" IS DELIBERATE - do not "improve" this with a tween.
         Five separate windows draw OSD furniture (DialogSeekBar, VideoOSD, Custom_1152,
         Custom_1153, VideoFullScreen) and each fades out on its own schedule when playback stops.
         Each carries its own copy of this animation, so with a non-zero time the reverse slide
         plays DURING those fades and the OSD is seen tracking back down at three different
         moments - once per fading window. At time="0" the controls are already at rest before the
         fades begin, which is exactly how the OSD behaves on content that has no inset at all.
         There is no cost to this: the inset only ever changes at playback start or stop, when the
         OSD is not on screen, so an animated transition can never be seen except as this
         artefact. -->
    <include name="Animation_OSD_MatchContent_Slide">
        <definition>
            <animation effect="slide" start="0,0" end="0,$PARAM[offset]" time="0" condition="$EXP[Exp_OSD_MatchContent] + String.IsEqual(Window(Home).Property(SkinMod.OSDAspect),$PARAM[aspect])" reversible="true">Conditional</animation>
        </definition>
    </include>

    <include name="Animation_OSD_MatchContent_Bottom">
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">1.85</param><param name="offset">-21</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.00</param><param name="offset">-60</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.20</param><param name="offset">-104</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.35</param><param name="offset">-132</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.40</param><param name="offset">-140</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.55</param><param name="offset">-164</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.76</param><param name="offset">-192</param></include>
    </include>

    <include name="Animation_OSD_MatchContent_Top">
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">1.85</param><param name="offset">21</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.00</param><param name="offset">60</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.20</param><param name="offset">104</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.35</param><param name="offset">132</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.40</param><param name="offset">140</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.55</param><param name="offset">164</param></include>
        <include content="Animation_OSD_MatchContent_Slide"><param name="aspect">2.76</param><param name="offset">192</param></include>
    </include>

    <!-- Fullscreen Window Changes -->
    <include name="Animation_OSD_Fullscreen_Change">
        <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
        <!-- SKINMOD: see the note in VideoOSD.xml. The close fade is skipped once the player has
             released the file, so teardown on stop is immediate instead of waiting out 300ms of
             fade over an already-deleted video plane. Used by VideoFullScreen, DialogSeekBar,
             DialogFullScreenInfo, MusicVisualisation and the OSD_Background_Dim layers - the
             condition is correct for all of them, since none has anything to fade over once
             playback has ended. -->
        <animation effect="fade" end="0" start="100" time="300" condition="Player.HasMedia">WindowClose</animation>
        <animation effect="fade" end="0" start="0" time="0" condition="!Player.HasMedia">WindowClose</animation>
        <animation effect="fade" start="0" end="100" time="300">VisibleChange</animation>
    </include>

    <!-- ==== -->
    <!-- Busy -->
    <!-- ==== -->
    <include name="Animation_Busy_Fade">
        <param name="end">20</param>
        <definition>
            <animation effect="fade" start="100" end="$PARAM[end]" time="200" condition="Container($PARAM[id]).IsUpdating">Conditional</animation>
        </definition>
    </include>


    <!-- ======== -->
    <!-- Standard -->
    <!-- ======== -->

    <!-- Zoom Animations -->
    <include name="Animation_Zoom_In">
        <param name="type">Conditional</param>
        <param name="condition">true</param>
        <param name="reversible">false</param>
        <param name="delay">0</param>
        <definition>
            <animation type="$PARAM[type]" reversible="$PARAM[reversible]" condition="$PARAM[condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[delay]" tween="sine" easing="in" />
                <effect type="zoom" start="85" end="100" time="300" delay="$PARAM[delay]" center="auto" tween="sine" easing="out" />
            </animation>
        </definition>
    </include>
    <include name="Animation_Zoom_Out">
        <param name="type">Conditional</param>
        <param name="condition">true</param>
        <param name="reversible">false</param>
        <param name="delay">0</param>
        <definition>
            <animation type="$PARAM[type]" reversible="$PARAM[reversible]" condition="$PARAM[condition]">
                <effect type="zoom" start="100" end="85" center="auto" tween="sine" delay="$PARAM[delay]" easing="out" time="300" />
                <effect type="fade" start="100" end="0" tween="cubic" easing="out" delay="$PARAM[delay]" time="300" />
            </animation>
        </definition>
    </include>

    <include name="_Animation_Widget_FadeOut">
        <param name="end">30</param>
        <definition>
            <animation effect="fade" start="100" end="$PARAM[end]" time="200" condition="$PARAM[condition]">Conditional</animation>
        </definition>
    </include>

    <include name="Animation_Widget_FadeOut">
        <param name="condition">true</param>
        <definition>
            <include content="_Animation_Widget_FadeOut">
                <param name="end">30</param>
                <param name="condition">$PARAM[condition]</param>
            </include>
        </definition>
    </include>

    <!-- Slide Animations -->
    <include name="Animation_Slide_In">
        <param name="type">Conditional</param>
        <param name="condition">true</param>
        <param name="delay">0</param>
        <param name="posx">0</param>
        <param name="posy">0</param>
        <param name="reversible">false</param>
        <param name="slide_tween">cubic</param>
        <param name="slide_easing">out</param>
        <definition>
            <animation type="$PARAM[type]" reversible="$PARAM[reversible]" condition="$PARAM[condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[delay]" tween="sine" easing="out"/>
                <effect type="slide" start="$PARAM[posx],$PARAM[posy]" end="0" time="400" delay="$PARAM[delay]" tween="$PARAM[slide_tween]" easing="$PARAM[slide_easing]" />
            </animation>
        </definition>
    </include>
    <include name="Animation_Slide_Out">
        <param name="type">Conditional</param>
        <param name="condition">true</param>
        <param name="delay">0</param>
        <param name="posx">0</param>
        <param name="posy">0</param>
        <param name="reversible">false</param>
        <param name="slide_tween">cubic</param>
        <param name="slide_easing">out</param>
        <definition>
            <animation type="$PARAM[type]" reversible="$PARAM[reversible]" condition="$PARAM[condition]">
                <effect type="fade" start="100" end="0" time="300" delay="$PARAM[delay]" tween="sine" easing="out"/>
                <effect type="slide" start="0" end="$PARAM[posx],$PARAM[posy]" time="300" delay="$PARAM[delay]" tween="$PARAM[slide_tween]" easing="$PARAM[slide_easing]" />
            </animation>
        </definition>
    </include>

    <!-- Directional Slides -->
    <include name="Animation_Direction">
        <param name="windowopen_condition">true</param>
        <param name="windowclose_condition">true</param>
        <param name="delay">0</param>
        <param name="posx">0</param>
        <param name="posy">0</param>
        <definition>
            <include content="Animation_Slide_In">
                <param name="type">Visible</param>
                <param name="delay">$PARAM[delay]</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
            <include content="Animation_Slide_In">
                <param name="condition">$PARAM[windowopen_condition]</param>
                <param name="type">WindowOpen</param>
                <param name="delay">$PARAM[delay]</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
            <include content="Animation_Slide_Out">
                <param name="type">Hidden</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
            <include content="Animation_Slide_Out">
                <param name="condition">$PARAM[windowclose_condition]</param>
                <param name="type">WindowClose</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Direction_Delay">
        <definition>
            <include content="Animation_Direction">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="delay">400</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Right">
        <definition>
            <include content="Animation_Direction">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posx">320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Right_Delay">
        <definition>
            <include content="Animation_Direction_Delay">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posx">320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Left">
        <definition>
            <include content="Animation_Direction">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posx">-320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Left_Delay">
        <definition>
            <include content="Animation_Direction_Delay">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posx">-320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Down">
        <definition>
            <include content="Animation_Direction">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posy">320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Down_Delay">
        <definition>
            <include content="Animation_Direction_Delay">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posy">320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Widgets_Grouplist_Slide_In">
        <param name="type">Conditional</param>
        <param name="posx">0</param>
        <param name="posy">0</param>
        <param name="condition">True</param>
        <param name="time">400</param>
        <param name="delay">0</param>
        <param name="fade_time">200</param>
        <param name="fade_delay">0</param>
        <param name="tween">quadratic</param>
        <param name="easing" />
        <definition>
            <animation type="$PARAM[type]" reversible="false" condition="$PARAM[condition]">
                <effect type="fade" start="0" end="100" delay="$PARAM[fade_delay]" time="$PARAM[fade_time]" tween="sine" easing="out"/>
                <effect type="slide" start="$PARAM[posx],$PARAM[posy]" end="0" delay="$PARAM[delay]" time="$PARAM[time]" tween="$PARAM[tween]" easing="$PARAM[easing]" />
            </animation>
        </definition>
    </include>

    <include name="Animation_Widgets_Grouplist_Slide_Out">
        <param name="type">Conditional</param>
        <param name="posx">0</param>
        <param name="posy">0</param>
        <param name="condition">True</param>
        <param name="time">400</param>
        <param name="fade_time">200</param>
        <param name="fade_delay">0</param>
        <param name="tween">quadratic</param>
        <param name="easing" />
        <definition>
            <animation type="$PARAM[type]" reversible="false" condition="$PARAM[condition]">
                <effect type="fade" start="100" end="0" delay="$PARAM[fade_delay]" time="$PARAM[fade_time]" tween="sine" easing="out"/>
                <effect type="slide" start="0" end="$PARAM[posx],$PARAM[posy]" time="$PARAM[time]" tween="$PARAM[tween]" easing="$PARAM[easing]" />
            </animation>
        </definition>
    </include>

    <!-- Window Transition For Views -->
    <include name="Animation_View_WindowChangeAnimation">
        <param name="windowopen_condition">!$EXP[Exp_PlainBackgroundWindows_Prev]</param>
        <param name="windowclose_condition">!$EXP[Exp_PlainBackgroundWindows_Next]</param>
        <definition>
            <!-- <animation effect="fade" start="100" end="0" time="200" tween="sine" easing="out" condition="$PARAM[windowclose_condition]">WindowClose</animation>
            <animation effect="fade" start="0" end="100" time="200" tween="sine" easing="out" condition="$PARAM[windowopen_condition]">WindowOpen</animation> -->
        </definition>
    </include>
    <include name="Animation_View_WindowChange">
        <param name="windowopen_condition">!$EXP[Exp_PlainBackgroundWindows_Prev]</param>
        <param name="windowclose_condition">!$EXP[Exp_PlainBackgroundWindows_Next]</param>
        <definition>
            <visible>!$EXP[Exp_InfoDialogs]</visible>

            <include content="Animation_View_WindowChangeAnimation">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
            </include>
            <include content="Animation_Zoom_In">
                <param name="type">Visible</param>
            </include>
            <include content="Animation_Zoom_Out">
                <param name="type">Hidden</param>
            </include>
        </definition>
    </include>

    <!-- Home Slide In -->
    <include name="Animation_Home_Menu">
        <include content="Animation_Slide_In">
            <param name="type">Visible</param>
            <param name="posx">-60</param>
        </include>
        <include content="Animation_Slide_Out">
            <param name="type">Hidden</param>
            <param name="posx">-60</param>
        </include>
    </include>

    <!-- Conditional Fade to allow Include Conditions -->
    <include name="Animation_ConditionalFade">
        <param name="end">0</param>
        <param name="condition">true</param>
        <definition>
            <animation effect="fade" start="100" end="$PARAM[end]" condition="$PARAM[condition]">Conditional</animation>
        </definition>
    </include>

    <!-- Focus Bounce for Select Box -->
    <include name="Animation_FocusBounce">
        <animation type="Focus" reversible="false">
            <effect type="zoom" start="96.5" end="100" time="150" tween="sine" easing="inout" center="auto"/>
            <effect type="fade" start="20" end="100" time="150" tween="back" easing="out"/>
        </animation>
    </include>

    <include name="Animation_DialogInfoButton_ZoomIn">
        <animation type="WindowOpen" reversible="false">
            <effect type="zoom" start="20" end="100" delay="$PARAM[delay]" time="400" tween="back" easing="out" center="auto"/>
            <effect type="fade" start="0" end="100" delay="$PARAM[delay]" time="200" />
        </animation>
    </include>

    <!-- Standard Animations -->
    <include name="Animation_Fade_In">
        <param name="condition">true</param>
        <param name="type">Conditional</param>
        <param name="delay">0</param>
        <param name="time">400</param>
        <param name="reversible">false</param>
        <definition>
            <animation effect="fade" start="0" end="100" delay="$PARAM[delay]" time="$PARAM[time]" tween="sine" easing="in" reversible="$PARAM[reversible]" condition="$PARAM[condition]">$PARAM[type]</animation>
        </definition>
    </include>

    <include name="Animation_Fade_Out">
        <param name="condition">true</param>
        <param name="type">Conditional</param>
        <param name="delay">0</param>
        <param name="time">300</param>
        <param name="reversible">false</param>
        <definition>
            <animation effect="fade" start="100" end="0" delay="$PARAM[delay]" time="$PARAM[time]" tween="sine" easing="in" reversible="$PARAM[reversible]" condition="$PARAM[condition]">$PARAM[type]</animation>
        </definition>
    </include>


    <include name="Animation_FadeIn">
        <include content="Animation_Fade_In">
            <param name="type">Visible</param>
        </include>
        <include content="Animation_Fade_In">
            <param name="type">WindowOpen</param>
        </include>
    </include>

    <include name="Animation_FadeIn_Delay">
        <include content="Animation_Fade_In">
            <param name="type">Visible</param>
            <param name="delay">400</param>
        </include>
        <include content="Animation_Fade_In">
            <param name="type">WindowOpen</param>
            <param name="delay">400</param>
        </include>
    </include>

    <include name="Animation_FadeOut">
        <include content="Animation_Fade_Out">
            <param name="type">Hidden</param>
        </include>
        <include content="Animation_Fade_Out">
            <param name="type">WindowClose</param>
        </include>
    </include>

    <include name="Animation_SlideIn_Dialog">
        <param name="visible_delay">150</param>
        <param name="visible_condition">true</param>
        <param name="windowopen_delay">400</param>
        <param name="windowopen_condition">true</param>
        <param name="posy">-48</param>
        <definition>
            <animation type="Visible" reversible="false" condition="$PARAM[visible_condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[visible_delay]"/>
                <effect type="slide" start="0,$PARAM[posy]" end="0" center="auto" tween="back" easing="out" time="400" delay="$PARAM[visible_delay]"/>
            </animation>
            <animation type="WindowOpen" reversible="false" condition="$PARAM[windowopen_condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[windowopen_delay]"/>
                <effect type="slide" start="0,$PARAM[posy]" end="0" center="auto" tween="back" easing="out" time="400" delay="$PARAM[windowopen_delay]"/>
            </animation>
        </definition>
    </include>

    <include name="Animation_SlideIn_Dialog_Manage">
        <include>Animation_SlideIn_Dialog</include>
        <animation effect="fade" time="0" delay="0">WindowClose</animation>
    </include>

    <include name="Animation_SlideIn_Dialog_Conditional">
        <param name="visible_delay">150</param>
        <param name="visible_condition">true</param>
        <param name="posy">-48</param>
        <definition>
            <animation type="Conditional" reversible="false" condition="$PARAM[visible_condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[visible_delay]"/>
                <effect type="slide" start="0,$PARAM[posy]" end="0" center="auto" tween="back" easing="out" time="400" delay="$PARAM[visible_delay]"/>
            </animation>
        </definition>
    </include>

    <include name="Animation_SlideIn_Dialog_Left">
        <param name="visible_delay">150</param>
        <param name="visible_condition">true</param>
        <param name="windowopen_delay">400</param>
        <param name="windowopen_condition">true</param>
        <definition>
            <animation type="Visible" reversible="false" condition="$PARAM[visible_condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[visible_delay]"/>
                <effect type="slide" start="-48" end="0" center="auto" tween="back" easing="out" time="400" delay="$PARAM[visible_delay]"/>
            </animation>
            <animation type="WindowOpen" reversible="false" condition="$PARAM[windowopen_condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[windowopen_delay]"/>
                <effect type="slide" start="-48" end="0" center="auto" tween="back" easing="out" time="400" delay="$PARAM[windowopen_delay]"/>
            </animation>
        </definition>
    </include>

    <include name="Animation_Overlay_FadeIn">
        <param name="delay">0</param>
        <definition>
            <animation effect="fade" start="0" end="100" time="300" delay="$PARAM[delay]">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
        </definition>
    </include>

    <include name="Animation_Reposition">
        <param name="slide_x">0</param>
        <param name="slide_y">-80</param>
        <param name="numitems">3</param>
        <definition>
            <animation effect="slide" end="$PARAM[slide_x],$PARAM[slide_y]" condition="Integer.IsLess(Container($PARAM[id]).NumAllItems,$PARAM[numitems]) + !Integer.IsEqual(Container($PARAM[id]).NumAllItems,0)">Conditional</animation>
        </definition>
    </include>

    <include name="Animation_Group_Bumper">
        <!-- Up (for ondown) -->
        <animation type="Conditional" condition="Control.IsVisible(330)" reversible="false">
            <effect type="slide" end="0,-20" time="60" tween="sine" />
            <effect type="slide" end="0,20" time="180" tween="sine" delay="80" />
        </animation>

        <!-- Right (for onleft) -->
        <include>Animation_Group_Bumper_Right</include>

        <!-- Left (for onright) -->
        <animation type="Conditional" condition="Control.IsVisible(332)" reversible="false">
            <effect type="slide" end="-20" time="60" tween="sine" />
            <effect type="slide" end="20" time="180" tween="sine" delay="80" />
        </animation>

        <!-- Down (for onup) -->
        <animation type="Conditional" condition="Control.IsVisible(333)" reversible="false">
            <effect type="slide" end="0,20" time="60" tween="sine" />
            <effect type="slide" end="0,-20" time="180" tween="sine" delay="80" />
        </animation>
    </include>

    <include name="Animation_Group_Bumper_Right">
        <animation type="Conditional" condition="Control.IsVisible(331)" reversible="false">
            <effect type="slide" end="20" time="60" tween="sine" />
            <effect type="slide" end="-20" time="180" tween="sine" delay="80" />
        </animation>
    </include>

    <include name="Animation_Home_Menu_Label">
        <include content="Animation_Slide_In">
            <param name="type">Visible</param>
            <param name="posx">-40</param>
        </include>
        <include content="Animation_Slide_Out">
            <param name="type">Hidden</param>
            <param name="posx">-40</param>
        </include>
    </include>

    <include name="Animation_Home_Menu_Fade">
        <include content="Animation_Fade_In">
            <param name="type">Visible</param>
            <param name="time">200</param>
        </include>
        <include content="Animation_Fade_Out">
            <param name="type">Hidden</param>
            <param name="time">400</param>
            <param name="delay">0</param>
        </include>
    </include>
    <include name="Animation_Search_Fade">
        <include content="Animation_Fade_In">
            <param name="condition">[!ControlGroup(5000).HasFocus() + !Control.HasFocus(330) + !Control.HasFocus(332) + !Control.HasFocus(333)]</param>
            <param name="time">200</param>
        </include>
        <include content="Animation_Fade_Out">
            <param name="condition">![!ControlGroup(5000).HasFocus() + !Control.HasFocus(330) + !Control.HasFocus(332) + !Control.HasFocus(333)]</param>
            <param name="time">400</param>
            <param name="delay">0</param>
        </include>
    </include>

</includes>