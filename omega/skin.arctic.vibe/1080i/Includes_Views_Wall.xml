    <!-- Row Template View -->
    <include name="View_Wall_Include">
        <definition>
            <control type="group">
                <visible>Control.IsVisible($PARAM[id])</visible>
                <control type="group">

                    <include content="$PARAM[include]">
                        <param name="id">$PARAM[id]</param>
                        <param name="control">panel</param>
                        <param name="orientation">vertical</param>
                        <param name="offset_y">40</param>
                        <preloaditems>0</preloaditems>
                        <!-- SKINMOD: was top 200 / bottom 140, a 740px band that fit only two
                             350px rows. The 200 reserved space for the wall-only header (now
                             removed in View_Row_Info); the 140 reserved space for a footer this
                             mod had already emptied - every remaining bottom control is
                             focus-gated, so nothing persistent lived there. 0/0 = three rows.

                             DO NOT add left/right here. The panel is meant to span the full
                             1920: List_Core insets each itemlayout by offset_x (view_offx, 80),
                             which already centres the grid - first artwork at x80, last ending
                             at x1840, 80px margins both sides. Insetting the panel as well
                             double-counts and pushes the last column off the right edge.
                             See MOD_CHANGELOG section 21e. -->
                        <top>wall_top</top>
                        <bottom>wall_bottom</bottom>
                        <onleft>600</onleft>
                        <onright>611</onright>

                        <include content="Action_View_Movement_OnBack">
                            <param name="id">$PARAM[id]</param>
                            <param name="onback">True</param>
                        </include>

                        <pagecontrol>66</pagecontrol>
                        <visible>$PARAM[visible]</visible>
                        <viewtype label="$PARAM[viewtype_label]">wrap</viewtype>
                        <onfocus>ClearProperty(TMDbHelper.WidgetContainer)</onfocus>
                        <onfocus>SetProperty(Background.ShowOverlay,True,Home)</onfocus>
                    </include>

                    <!-- SKINMOD: the old column-major wall branch (2 rows x N columns,
                         scrolling horizontally) has been removed. -->
                </control>
            </control>
        </definition>
    </include>
</includes>
